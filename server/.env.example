# Copia este archivo a `.env` y rellena los valores reales.
# `server/.env` esta ignorado por git y NO debe versionarse.

DB_NAME=jose
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=cambia-esta-password

# false = el esquema se crea con db/init.sql (recomendado).
# true  = TypeORM ajusta el esquema segun las entidades en cada arranque.
DB_SYNCHRONIZE=false

JWT_SECREAT=cambia-este-secreto

API_KEY_GOOGLE=

# Cuenta de servicio de Firebase (JSON en una sola linea).
FIREBASE_CREDENTIAL_JSON={}

# Cuenta de correo (JSON en una sola linea).
ACCOUNT_TRANSPORT={}

STRIPE_SECRET_KEY=
