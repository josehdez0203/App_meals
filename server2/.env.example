SERVER_ADDRESS=:3000
JWT_SECRET=change-this-secret-in-production

# Credenciales de PostgreSQL. Las usan tanto la API como compose.yaml, asi que
# no hace falta repetir los valores.
DB_NAME=delivery
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=123456

# DATABASE_URL se arma con las variables de arriba (mismo archivo).
DATABASE_URL=postgres://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable

# Integraciones externas (opcionales). Si quedan vacias, la API arranca con los
# stubs no-op de internal/integrations.
FIREBASE_CREDENTIAL_JSON=
API_KEY_GOOGLE=
ACCOUNT_TRANSPORT=
STRIPE_SECRET_KEY=
